# =============================================================================
# KAEL Trading Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# IQ OPTION CREDENTIALS (Required)
# =============================================================================
IQOPTION_EMAIL=your_email@example.com
IQOPTION_PASSWORD=your_password_here

# =============================================================================
# TRADING MODE
# =============================================================================
# Options: demo | live
# WARNING: 'live' mode uses real money!
TRADING_MODE=demo

# =============================================================================
# ADVANCED STRATEGIES
# =============================================================================
# Enable advanced TA-Lib based strategies (true/false)
# When enabled, uses 7 sophisticated strategies with technical indicators
# When disabled, uses simple candle counting strategy
USE_ADVANCED_STRATEGIES=true

# Risk profile for advanced strategies
# Options: conservative | moderate | aggressive
# conservative: High confidence required (85%+), max $1.50/trade, max $5 daily loss
# moderate: Balanced (75%+ confidence), max $2/trade, max $10 daily loss (default)
# aggressive: More opportunities (70%+ confidence), max $3/trade, max $15 daily loss
STRATEGY_RISK_PROFILE=moderate

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL/TimescaleDB connection (optional, uses SQLite if not provided)
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://kaeluser:kaelpass@localhost:5432/kael_trading

# =============================================================================
# AI MODEL API KEYS (Optional)
# =============================================================================
# Anthropic Claude API
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API
# OPENAI_API_KEY=sk-...

# DeepSeek API (uses OpenAI-compatible endpoint)
# DEEPSEEK_API_KEY=sk-...

# =============================================================================
# TRADING PARAMETERS
# =============================================================================
# Minimum payout ratio to accept (0.0-1.0)
MIN_PAYOUT_RATIO=0.75

# Minimum candles to fetch for analysis
MIN_CANDLES=50

# Scan interval in seconds (how often to check for opportunities)
SCAN_INTERVAL_SECONDS=3

# Maximum concurrent trades
MAX_CONCURRENT_TRADES=2

# =============================================================================
# FICTITIOUS BALANCE (For Testing)
# =============================================================================
# Enable fictitious balance tracking (true/false)
# When true, tracks P&L from a $100 starting point while using real demo balance
ENABLE_FICTITIOUS_BALANCE=true
FICTITIOUS_START_BALANCE=100.00

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# =============================================================================
# NOTES
# =============================================================================
# 1. For $100 real money trading, recommended settings:
#    - USE_ADVANCED_STRATEGIES=true
#    - STRATEGY_RISK_PROFILE=moderate or conservative
#    - TRADING_MODE=demo (for first week validation)
#
# 2. TA-Lib Installation (for advanced strategies):
#    - Linux: sudo apt-get install ta-lib
#    - Mac: brew install ta-lib
#    - Windows: Download from https://github.com/cgohlke/talib-build/releases
#    Then: pip install TA-Lib
#
# 3. If TA-Lib is not installed, bot will use pure Python fallback implementations
#
# 4. Always test new configurations in DEMO mode first!
