# ============================================================================
# KAEL Trading System - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!
# ============================================================================

# ============================================================================
# IQOption Account Credentials (REQUIRED)
# ============================================================================
IQOPTION_EMAIL=your_email@example.com
IQOPTION_PASSWORD=your_password
ACCOUNT_TYPE=demo  # Options: demo, real (USE DEMO FOR TESTING!)

# ============================================================================
# AI Models Configuration
# ============================================================================
# Free AI (No API key required - RECOMMENDED FOR TESTING)
USE_FREE_AI=true
FREE_AI_TYPE=rule-based  # Options: rule-based, huggingface
FREE_AI_WEIGHT=1.5

# OpenAI (Requires API key)
USE_OPENAI=false
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_WEIGHT=1.2

# Anthropic Claude (Requires API key)
USE_CLAUDE=false
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key-here
CLAUDE_MODEL=claude-3-5-haiku-20241022
CLAUDE_WEIGHT=1.0

# DeepSeek (Requires API key)
USE_DEEPSEEK=false
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_WEIGHT=1.0

# ============================================================================
# Trading Parameters
# ============================================================================
# Position Sizing
BASE_AMOUNT=2.0          # Base trade amount in USD
MIN_AMOUNT=1.0           # Minimum trade amount
MAX_AMOUNT=20.0          # Maximum trade amount

# Trade Duration
DEFAULT_DURATION=1       # Default trade duration in minutes (1-5)

# Signal Confidence
MIN_CONFIDENCE=65        # Minimum confidence to execute trade (0-100)
CONSENSUS_THRESHOLD=0.66 # AI consensus threshold (0.5-1.0, 66% = 2/3 agreement)

# ============================================================================
# Risk Management
# ============================================================================
MAX_DAILY_LOSS=50.0           # Maximum daily loss in USD
MAX_DAILY_PROFIT=200.0        # Daily profit target in USD
MAX_CONSECUTIVE_LOSSES=3      # Stop after N consecutive losses
MIN_ACCOUNT_BALANCE=50.0      # Minimum balance required to trade

# ============================================================================
# Market Analysis
# ============================================================================
CANDLE_COUNT=100         # Number of candles to analyze
TIMEFRAME=1m             # Candle timeframe (1m, 5m, 15m, etc.)

# Technical Indicators Periods
RSI_PERIOD_14=14
RSI_PERIOD_7=7
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD=2

# ============================================================================
# Database Configuration
# ============================================================================
DB_PATH=data/trades_advanced.db

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO           # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/trading.log

# ============================================================================
# Advanced Settings (Optional)
# ============================================================================
# Connection Settings
CONNECTION_TIMEOUT=30
MAX_RETRIES=5
RETRY_DELAY=10

# Performance Settings
ENABLE_CACHING=true
CACHE_TTL=300            # Cache time-to-live in seconds

# Monitoring
ENABLE_METRICS=true
METRICS_INTERVAL=60      # Metrics collection interval in seconds

# ============================================================================
# Development/Testing Settings
# ============================================================================
DEBUG_MODE=false
DRY_RUN=false           # Simulate trades without execution
VERBOSE_LOGGING=false

# ============================================================================
# Notes:
# ============================================================================
# 1. Always start with ACCOUNT_TYPE=demo for testing
# 2. FREE_AI works without any API keys
# 3. For production, use strong passwords and keep .env secure
# 4. Adjust risk parameters based on your risk tolerance
# 5. Monitor logs regularly for system health
# ============================================================================