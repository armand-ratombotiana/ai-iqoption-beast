# IQOption Trading System Configuration
# Copy this file to .env and update with your credentials

# Account Configuration
IQOPTION_EMAIL=your_email@example.com
IQOPTION_PASSWORD=your_password
ACCOUNT_TYPE=PRACTICE  # PRACTICE or REAL

# Risk Management
RISK_PER_TRADE=0.02       # 2% per trade
MAX_DAILY_LOSS=0.10       # 10% max daily loss
MAX_CONCURRENT_TRADES=3   # Maximum concurrent positions
MIN_ACCOUNT_BALANCE=50    # Minimum balance to continue trading

# Trade Parameters
BASE_TRADE_AMOUNT=2.0     # Base trade amount in USD
MAX_TRADE_AMOUNT=20.0     # Maximum trade amount
MIN_CONFIDENCE=60         # Minimum confidence % to execute trade

# Martingale Strategy
MARTINGALE_ENABLED=True   # Enable/disable Martingale
MARTINGALE_MULTIPLIER=1.5 # Multiplier after loss
MAX_MARTINGALE_LEVEL=3    # Maximum Martingale steps

# Trading Assets (comma-separated)
TRADING_ASSETS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD

# Performance
MAX_WORKERS=3             # Parallel processing workers

# Logging
LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR
