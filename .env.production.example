# =============================================================================
# AUTONOMOUS 24/7 TRADING BOT - PRODUCTION CONFIGURATION
# =============================================================================
# Copy this file to .env and configure for your setup
# CRITICAL: Never commit .env file with real credentials!

# =============================================================================
# IQ OPTION CREDENTIALS (REQUIRED)
# =============================================================================
IQOPTION_EMAIL=your_email@example.com
IQOPTION_PASSWORD=your_password

# =============================================================================
# TRADING MODE
# =============================================================================
# Options: 'demo' or 'live'
# ALWAYS start with 'demo' for testing!
TRADING_MODE=demo

# =============================================================================
# BINARY OPTIONS SETTINGS
# =============================================================================
# Trading amount per position (in dollars)
BASE_TRADE_AMOUNT=1.0
MAX_TRADE_AMOUNT=10.0

# Preferred trading assets (comma-separated, most liquid pairs)
# These are checked first for best spreads and availability
TRADING_ASSETS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,NZDUSD,EURJPY,GBPJPY

# =============================================================================
# RISK MANAGEMENT (CRITICAL!)
# =============================================================================
# Maximum loss per day before bot stops trading (in dollars)
MAX_DAILY_LOSS=50

# Target profit per day (bot stops when reached)
MAX_DAILY_PROFIT=100

# Maximum consecutive losses before bot pauses
MAX_CONSECUTIVE_LOSSES=5

# Minimum account balance required to trade
MIN_BALANCE=50

# Maximum trades per hour (rate limiting)
MAX_TRADES_PER_HOUR=30

# Maximum trades per day
MAX_TRADES_PER_DAY=200

# =============================================================================
# MARTINGALE STRATEGY
# =============================================================================
# Enable/disable martingale (true/false)
# WARNING: Martingale can lead to significant losses!
ENABLE_MARTINGALE=true

# Multiplier for next trade after loss
# Example: 1.5 means next trade is 1.5x the previous
MARTINGALE_MULTIPLIER=1.5

# Maximum martingale levels allowed
# After this many losses, martingale resets
MAX_MARTINGALE_LEVEL=3

# =============================================================================
# AI SIGNAL REQUIREMENTS
# =============================================================================
# Minimum confidence required from AI (0-100)
MIN_AI_CONFIDENCE=65

# Minimum consensus agreement from multiple AI models (0.0-1.0)
# 0.7 = 70% of models must agree
MIN_CONSENSUS_AGREEMENT=0.7

# =============================================================================
# TIMING CONTROLS
# =============================================================================
# Minimum seconds between trades (buffer time)
MIN_SECONDS_BETWEEN_TRADES=70

# =============================================================================
# HEALTH MONITORING
# =============================================================================
# Enable health check API endpoint
ENABLE_HEALTH_API=true

# Port for health monitoring API
HEALTH_API_PORT=5001

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# ADVANCED SETTINGS (Optional)
# =============================================================================
# Auto-restart on errors (recommended for 24/7 operation)
AUTO_RESTART_ON_ERROR=true

# Maximum restart attempts
MAX_RESTART_ATTEMPTS=100

# Delay between restart attempts (seconds)
RESTART_DELAY_SECONDS=60

# Connection health check interval (seconds)
CONNECTION_CHECK_INTERVAL=300

# =============================================================================
# EMERGENCY STOP
# =============================================================================
# Create a file named 'EMERGENCY_STOP' in the project root to immediately
# halt all trading. The bot will check for this file before each trade.
# To create: touch EMERGENCY_STOP
# To remove: rm EMERGENCY_STOP
