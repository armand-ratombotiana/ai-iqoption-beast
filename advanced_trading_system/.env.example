# Trading System Environment Variables
# Copy this file to .env and fill in your actual values

# ========================================================================
# IQOption Account (Required)
# ========================================================================
IQOPTION_EMAIL=tombokael4@gmail.com
IQOPTION_PASSWORD=tombokael04
ACCOUNT_TYPE=demo  # 'demo' or 'real'

# ========================================================================
# AI Model API Keys (Optional - system works without them)
# ========================================================================
# Get your Claude API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=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

# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Get your DeepSeek API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# ========================================================================
# AI Model Configuration
# ========================================================================
USE_OPENAI=false
USE_CLAUDE=true
USE_DEEPSEEK=false

OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-3-5-haiku-20241022
DEEPSEEK_MODEL=deepseek-chat

# AI Model Weights (for consensus voting)
OPENAI_WEIGHT=1.2
CLAUDE_WEIGHT=1.0
DEEPSEEK_WEIGHT=1.0

# ========================================================================
# Trading Parameters
# ========================================================================
BASE_AMOUNT=2.0
MIN_AMOUNT=1.0
MAX_AMOUNT=20.0
DEFAULT_DURATION=1

# ========================================================================
# Consensus Settings
# ========================================================================
CONSENSUS_THRESHOLD=0.66  # 66% agreement required
MIN_CONFIDENCE=65  # Minimum confidence to execute trade

# ========================================================================
# Risk Management
# ========================================================================
MAX_DAILY_LOSS=50.0
MAX_DAILY_PROFIT=200.0
MAX_CONSECUTIVE_LOSSES=3
MIN_ACCOUNT_BALANCE=50.0

# ========================================================================
# Market Analysis
# ========================================================================
CANDLE_COUNT=100
TIMEFRAME=1m

# ========================================================================
# System Settings
# ========================================================================
DB_PATH=data/trades_advanced.db
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
