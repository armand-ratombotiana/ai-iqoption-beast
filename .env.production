# =============================================================================
# KAEL TRADING SYSTEM - PRODUCTION CONFIGURATION FOR $100 CAPITAL
# =============================================================================
# ⚠️ THIS IS FOR REAL MONEY TRADING - USE WITH EXTREME CAUTION!
# =============================================================================

# =============================================================================
# IQ OPTION CREDENTIALS (REPLACE WITH YOUR REAL CREDENTIALS!)
# =============================================================================
IQOPTION_EMAIL=tombokael4@gmail.com
IQOPTION_PASSWORD=tombokael04

# =============================================================================
# TRADING MODE - ⚠️ CRITICAL: SET TO 'live' FOR REAL MONEY
# =============================================================================
# Options: 'demo' or 'live'
# ⚠️ DOUBLE CHECK THIS IS SET CORRECTLY BEFORE STARTING!
TRADING_MODE=demo  # ⚠️ CHANGE TO 'live' WHEN READY

# =============================================================================
# POSITION SIZING - OPTIMIZED FOR $100 CAPITAL
# =============================================================================
# Conservative $1 trades (1% risk per trade)
BASE_TRADE_AMOUNT=1.0
MAX_TRADE_AMOUNT=2.0

# Binary options only
TRADING_ASSETS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,NZDUSD,EURJPY,GBPJPY,EURGBP,AUDJPY,EURAUD,GBPAUD,USDCHF,EURCAD,GBPCAD,AUDCAD

# =============================================================================
# STRICT RISK MANAGEMENT FOR $100 CAPITAL
# =============================================================================
# Daily Limits
MAX_DAILY_LOSS=5               # Stop at -$5 per day (5% of capital)
MAX_DAILY_PROFIT=20            # Take profits at +$20 (20% of capital)
MAX_CONSECUTIVE_LOSSES=3       # Stop after 3 losses in a row

# Capital Protection
MIN_BALANCE=80                 # EMERGENCY STOP if balance < $80 (20% drawdown)

# Volume Controls - Prevent Overtrading
MAX_TRADES_PER_HOUR=10         # Max 10 trades/hour
MAX_TRADES_PER_DAY=30          # Max 30 trades/day (quality over quantity)

# =============================================================================
# PARALLEL TRADING SETTINGS - CONSERVATIVE FOR REAL MONEY
# =============================================================================
MAX_CONCURRENT_INSTRUMENTS=2   # Only 2 simultaneous trades (was 3)
MAX_INSTRUMENTS_TO_MONITOR=16  # Monitor all available
PORTFOLIO_RISK_PERCENT=4.0     # Max 4% total portfolio risk (was 10%)
MAX_RISK_PER_INSTRUMENT=2.0    # Max 2% risk per instrument (was 2.5%)
CORRELATION_THRESHOLD=0.7      # Avoid correlated pairs
INSTRUMENT_SCAN_INTERVAL=3     # Scan every 3 seconds
MAX_WORKER_THREADS=15          # Parallel processing
MAX_TRADES_PER_INSTRUMENT_HOUR=5  # Max 5 trades per instrument per hour

# =============================================================================
# AI SIGNAL REQUIREMENTS - HIGHER QUALITY FOR REAL MONEY
# =============================================================================
MIN_AI_CONFIDENCE=70           # Higher confidence (was 60 on demo)
MIN_CONSENSUS_AGREEMENT=0.80   # Stronger AI consensus (was 0.70)

# =============================================================================
# TIMING CONTROLS - OPTIMIZED TO PREVENT "BUY LATE" ERRORS
# =============================================================================
MIN_TIME_TO_EXPIRY=45          # Minimum 45s before expiry
MAX_TIME_TO_EXPIRY=90          # Maximum 90s window
EXPIRATION_BUFFER=8            # 8s safety buffer
MIN_PAYOUT_RATIO=0.75          # Higher payout requirement (was 0.65)
MIN_SECONDS_BETWEEN_TRADES=70  # Cooldown between trades

# =============================================================================
# MARTINGALE STRATEGY - ⚠️ DISABLED FOR SAFETY
# =============================================================================
ENABLE_MARTINGALE=false        # NEVER use martingale with $100 capital
MARTINGALE_MULTIPLIER=1.0      # Disabled
MAX_MARTINGALE_LEVEL=0         # Disabled

# =============================================================================
# AI API KEYS (Optional - improves signal quality)
# =============================================================================
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# =============================================================================
# HEALTH MONITORING - ENABLED FOR REAL-TIME TRACKING
# =============================================================================
ENABLE_HEALTH_API=true
HEALTH_API_PORT=5001

# =============================================================================
# LOGGING - COMPREHENSIVE FOR REAL MONEY
# =============================================================================
LOG_LEVEL=INFO                 # Detailed logging

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
AUTO_RESTART_ON_ERROR=true
MAX_RESTART_ATTEMPTS=3         # Limited restarts (was 100)
RESTART_DELAY_SECONDS=300      # 5 min delay between restarts
CONNECTION_CHECK_INTERVAL=60   # Check connection every 60s

# =============================================================================
# PROFITABILITY OPTIMIZATIONS
# =============================================================================
# These settings maximize profitability while maintaining safety

# 1. Quality Over Quantity
#    - Only trade when AI confidence ≥ 70%
#    - Only trade when payout ≥ 75%
#    - Limit to 30 trades/day to avoid fatigue

# 2. Risk Management
#    - $1 base trade = 1% risk
#    - Max 2 concurrent trades = 2% total risk
#    - Stop at -$5 daily loss = 5% drawdown limit

# 3. Timing Optimization
#    - 45-90s execution window prevents "buy late" errors
#    - 8s buffer ensures trades execute on time
#    - No timing failures = no wasted trades

# 4. Expected Profitability at 60% Win Rate
#    Scenario: 20 trades/day, 60% win rate, 75% avg payout
#    Wins: 12 × $0.75 = $9.00
#    Losses: 8 × $1.00 = -$8.00
#    Daily Profit: +$1.00 (1% ROI)
#    Weekly Profit: +$5.00 (5% ROI)
#
# 5. Expected Profitability at 70% Win Rate
#    Scenario: 20 trades/day, 70% win rate, 75% avg payout
#    Wins: 14 × $0.75 = $10.50
#    Losses: 6 × $1.00 = -$6.00
#    Daily Profit: +$4.50 (4.5% ROI)
#    Weekly Profit: +$22.50 (22.5% ROI)

