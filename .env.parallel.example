# =============================================================================
# PARALLEL MULTI-INSTRUMENT TRADING BOT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure your settings
# cp .env.parallel.example .env

# =============================================================================
# BASIC SETTINGS
# =============================================================================

# Trading Mode: 'demo' for practice account, 'live' for real money
TRADING_MODE=demo

# IQ Option Credentials
IQOPTION_EMAIL=your_email@example.com
IQOPTION_PASSWORD=your_password

# =============================================================================
# PARALLEL TRADING SETTINGS
# =============================================================================

# Maximum number of instruments to trade simultaneously (1-10)
# Conservative: 2-3, Balanced: 5, Aggressive: 8-10
MAX_CONCURRENT_INSTRUMENTS=5

# Total number of instruments to monitor and analyze (10-50)
# More instruments = more opportunities but higher CPU usage
MAX_INSTRUMENTS_TO_MONITOR=20

# Enable dynamic instrument selection based on market conditions
ENABLE_DYNAMIC_INSTRUMENT_SELECTION=true

# =============================================================================
# PORTFOLIO RISK MANAGEMENT
# =============================================================================

# Total portfolio risk as percentage of balance (5-20%)
# This is the maximum % of balance allocated to all active trades
# Conservative: 5%, Balanced: 10%, Aggressive: 15%
PORTFOLIO_RISK_PERCENT=10.0

# Maximum risk per individual instrument (1-5%)
# Conservative: 1%, Balanced: 2.5%, Aggressive: 3%
MAX_RISK_PER_INSTRUMENT=2.5

# Correlation threshold to avoid trading correlated pairs (0.5-0.9)
# Higher = more strict correlation filtering
CORRELATION_THRESHOLD=0.7

# =============================================================================
# TRADING AMOUNTS
# =============================================================================

# Base trade amount in dollars
BASE_TRADE_AMOUNT=1.0

# Minimum trade amount (IQ Option minimum is usually $1)
MIN_TRADE_AMOUNT=1.0

# Maximum trade amount per trade
MAX_TRADE_AMOUNT=10.0

# =============================================================================
# INSTRUMENT POOL
# =============================================================================

# Comma-separated list of instruments to trade
# Forex Majors: EURUSD,GBPUSD,USDJPY,USDCHF
# Forex Minors: AUDUSD,USDCAD,NZDUSD
# Forex Crosses: EURJPY,GBPJPY,EURGBP,AUDJPY,EURAUD,GBPAUD
# Commodities: GOLD,SILVER,OIL
# Crypto: BTCUSD,ETHUSD

TRADING_ASSETS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,NZDUSD,EURJPY,GBPJPY,EURGBP,AUDJPY,EURAUD,GBPAUD,USDCHF,EURCAD,GBPCAD,AUDCAD

# =============================================================================
# DAILY RISK LIMITS
# =============================================================================

# Maximum daily loss in dollars - bot stops trading if reached
MAX_DAILY_LOSS=50

# Daily profit target in dollars - bot stops trading if reached
MAX_DAILY_PROFIT=100

# Maximum consecutive losses before pausing trading
MAX_CONSECUTIVE_LOSSES=5

# Minimum balance required to continue trading
MIN_BALANCE=50

# =============================================================================
# PER-INSTRUMENT LIMITS
# =============================================================================

# Maximum trades per instrument per hour
MAX_TRADES_PER_INSTRUMENT_HOUR=10

# Minimum seconds between trades on the same instrument
MIN_SECONDS_BETWEEN_TRADES=70

# =============================================================================
# GLOBAL TRADING LIMITS
# =============================================================================

# Maximum total trades per hour (all instruments combined)
MAX_TRADES_PER_HOUR=50

# Maximum total trades per day (all instruments combined)
MAX_TRADES_PER_DAY=300

# =============================================================================
# AI SIGNAL SETTINGS
# =============================================================================

# Minimum AI confidence percentage to execute trade (60-90)
# Conservative: 80%, Balanced: 70%, Aggressive: 65%
MIN_AI_CONFIDENCE=65

# Minimum consensus agreement between AI models (0.6-0.9)
# Higher = more agreement required
MIN_CONSENSUS_AGREEMENT=0.7

# =============================================================================
# TIMING SETTINGS
# =============================================================================

# Seconds to wait for trade result (should be > 60 for 1-minute options)
WAIT_FOR_RESULT_SECONDS=80

# Seconds between connection health checks
CONNECTION_CHECK_INTERVAL=300

# Seconds between instrument scanning cycles
# Lower = more frequent scanning, higher CPU usage
# Conservative: 60, Balanced: 30, Aggressive: 20
INSTRUMENT_SCAN_INTERVAL=30

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Maximum worker threads for parallel execution
# Should be >= MAX_CONCURRENT_INSTRUMENTS
# Conservative: 5, Balanced: 10, Aggressive: 20
MAX_WORKER_THREADS=10

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Enable health monitoring API
ENABLE_HEALTH_API=true

# Port for health monitoring API
HEALTH_API_PORT=5001

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# MARTINGALE SETTINGS (Optional)
# =============================================================================

# Enable Martingale strategy (increase position after loss)
# WARNING: Can lead to large losses if not managed properly
ENABLE_MARTINGALE=false

# Martingale multiplier (how much to increase after loss)
MARTINGALE_MULTIPLIER=1.5

# Maximum Martingale level (max consecutive increases)
MAX_MARTINGALE_LEVEL=3

# =============================================================================
# PRESET CONFIGURATIONS
# =============================================================================

# Uncomment one of these preset configurations:

# --- CONSERVATIVE PRESET ---
# MAX_CONCURRENT_INSTRUMENTS=3
# PORTFOLIO_RISK_PERCENT=5.0
# MAX_RISK_PER_INSTRUMENT=1.5
# MIN_AI_CONFIDENCE=80
# MAX_TRADES_PER_HOUR=20
# INSTRUMENT_SCAN_INTERVAL=60

# --- BALANCED PRESET (DEFAULT) ---
# MAX_CONCURRENT_INSTRUMENTS=5
# PORTFOLIO_RISK_PERCENT=10.0
# MAX_RISK_PER_INSTRUMENT=2.5
# MIN_AI_CONFIDENCE=70
# MAX_TRADES_PER_HOUR=50
# INSTRUMENT_SCAN_INTERVAL=30

# --- AGGRESSIVE PRESET ---
# MAX_CONCURRENT_INSTRUMENTS=10
# PORTFOLIO_RISK_PERCENT=15.0
# MAX_RISK_PER_INSTRUMENT=3.0
# MIN_AI_CONFIDENCE=65
# MAX_TRADES_PER_HOUR=100
# INSTRUMENT_SCAN_INTERVAL=20

# --- HIGH VOLUME PRESET ---
# MAX_CONCURRENT_INSTRUMENTS=10
# MAX_INSTRUMENTS_TO_MONITOR=30
# MAX_TRADES_PER_HOUR=100
# MAX_TRADES_PER_DAY=500
# INSTRUMENT_SCAN_INTERVAL=20

# =============================================================================
# NOTES
# =============================================================================

# 1. Always test in DEMO mode first before going live
# 2. Start with conservative settings and adjust based on results
# 3. Monitor the first hour closely when using new settings
# 4. Use the health API to track performance: http://localhost:5001/statistics
# 5. Review logs daily: logs/parallel_bot_YYYYMMDD.log
# 6. Set realistic daily loss limits (5-10% of balance)
# 7. Never risk more than you can afford to lose

# =============================================================================
# QUICK START EXAMPLES
# =============================================================================

# Example 1: Conservative Day Trading
# MAX_CONCURRENT_INSTRUMENTS=3
# PORTFOLIO_RISK_PERCENT=5.0
# MAX_DAILY_LOSS=25
# MIN_AI_CONFIDENCE=80

# Example 2: Balanced 24/7 Trading
# MAX_CONCURRENT_INSTRUMENTS=5
# PORTFOLIO_RISK_PERCENT=10.0
# MAX_DAILY_LOSS=50
# MIN_AI_CONFIDENCE=70

# Example 3: Aggressive Scalping
# MAX_CONCURRENT_INSTRUMENTS=8
# PORTFOLIO_RISK_PERCENT=15.0
# MAX_TRADES_PER_HOUR=100
# INSTRUMENT_SCAN_INTERVAL=20

# =============================================================================
