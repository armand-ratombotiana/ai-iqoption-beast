# ============================================================================
# KAEL TRADING SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================
# SECURITY INSTRUCTIONS:
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env file to version control!
# 3. Keep your credentials secure and rotate them regularly
# 4. Use strong, unique passwords for all services
# 5. Enable 2FA where possible
# ============================================================================

# ============================================================================
# ENVIRONMENT SETTINGS
# ============================================================================
# Environment: development, staging, production
# Used for environment-specific configurations and logging
ENVIRONMENT=production

# ============================================================================
# REQUIRED CREDENTIALS - IQ OPTION
# ============================================================================
# Your IQ Option account credentials
# SECURITY: These are REQUIRED for the trading system to function

# Email address for your IQ Option account
# Format: Must be a valid email address
# Example: john.doe@example.com
IQOPTION_EMAIL=your_email@example.com

# Password for your IQ Option account
# Format: Minimum 8 characters
# SECURITY: Use a strong, unique password
# Example: MyStr0ng!P@ssw0rd
IQOPTION_PASSWORD=your_secure_password

# Account type: demo or real
# SECURITY WARNING: Start with 'demo' for testing!
# Values: demo, real
# Default: demo
ACCOUNT_TYPE=demo

# ============================================================================
# OPTIONAL - AI API KEYS (For Cloud AI Models)
# ============================================================================
# These are optional. The system can work with free/local AI models.
# Only configure the AI providers you want to use.

# ----------------------------------------------------------------------------
# OpenAI (GPT Models)
# ----------------------------------------------------------------------------
# Get your key from: https://platform.openai.com/api-keys
# Format: Starts with 'sk-'
# Example: sk-proj-abc123...
# OPENAI_API_KEY=sk-...

# Enable OpenAI models (true/false)
# USE_OPENAI=false

# Model to use (default: gpt-4o-mini)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# OPENAI_MODEL=gpt-4o-mini

# Model weight for consensus (default: 1.2)
# OPENAI_WEIGHT=1.2

# ----------------------------------------------------------------------------
# Anthropic Claude (Claude Models)
# ----------------------------------------------------------------------------
# Get your key from: https://console.anthropic.com/
# Format: Starts with 'sk-ant-'
# Example: sk-ant-api03-abc123...
# ANTHROPIC_API_KEY=sk-ant-...

# Enable Claude models (true/false)
# USE_CLAUDE=false

# Model to use (default: claude-3-5-haiku-20241022)
# Options: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# CLAUDE_MODEL=claude-3-5-haiku-20241022

# Model weight for consensus (default: 1.0)
# CLAUDE_WEIGHT=1.0

# ----------------------------------------------------------------------------
# DeepSeek
# ----------------------------------------------------------------------------
# Get your key from: https://platform.deepseek.com/
# Example: sk-abc123...
# DEEPSEEK_API_KEY=...

# Enable DeepSeek models (true/false)
# USE_DEEPSEEK=false

# Model to use (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Model weight for consensus (default: 1.0)
# DEEPSEEK_WEIGHT=1.0

# ----------------------------------------------------------------------------
# HuggingFace (For OpenClaw Integration)
# ----------------------------------------------------------------------------
# Get your key from: https://huggingface.co/settings/tokens
# Format: Starts with 'hf_'
# Example: hf_abc123...
# HUGGINGFACE_API_KEY=hf_...

# ----------------------------------------------------------------------------
# OpenRouter (For OpenClaw Integration)
# ----------------------------------------------------------------------------
# Get your key from: https://openrouter.ai/keys
# Format: Starts with 'sk-or-'
# Example: sk-or-v1-abc123...
# OPENROUTER_API_KEY=sk-or-...

# ============================================================================
# OPENCLAW SETTINGS (Free, Local AI - RECOMMENDED)
# ============================================================================
# OpenClaw provides free AI capabilities using local or free cloud models
# This is enabled by default and requires no API keys for local backends

# Enable Free AI (default: true)
USE_FREE_AI=true

# Free AI type: rule-based, huggingface
FREE_AI_TYPE=rule-based

# Model weight for consensus (default: 1.5)
FREE_AI_WEIGHT=1.5

# Backend: ollama, huggingface, lmstudio, localai, openrouter
# ollama: Local Ollama installation (FREE, RECOMMENDED)
# huggingface: HuggingFace inference (requires API key)
# lmstudio: Local LM Studio (FREE)
# localai: Local LocalAI server (FREE)
# openrouter: OpenRouter API (requires API key)
OPENCLAW_BACKEND=ollama

# Model name (depends on backend)
# For Ollama: llama3.2, llama3.1, mistral, etc.
# For HuggingFace: meta-llama/Llama-3.2-3B-Instruct, etc.
OPENCLAW_MODEL=llama3.2

# Ollama URL (if using Ollama backend)
# Default: http://localhost:11434
OLLAMA_URL=http://localhost:11434

# LM Studio URL (if using LM Studio backend)
# Default: http://localhost:1234/v1/chat/completions
# LMSTUDIO_URL=http://localhost:1234/v1/chat/completions

# LocalAI URL (if using LocalAI backend)
# Default: http://localhost:8080/v1/chat/completions
# LOCALAI_URL=http://localhost:8080/v1/chat/completions

# ============================================================================
# CONSENSUS & AI SETTINGS
# ============================================================================
# Configure how AI models work together for trading decisions

# Consensus threshold (0.0-1.0)
# How many models must agree before making a trade
# 0.66 = 66% of models must agree
# Higher = more conservative, Lower = more aggressive
CONSENSUS_THRESHOLD=0.66

# Minimum confidence for trade execution (0-100)
# Individual model confidence threshold
# Higher = more selective, Lower = more trades
MIN_CONFIDENCE=65

# ============================================================================
# TRADING PARAMETERS
# ============================================================================
# Configure trading amounts and durations

# Base trade amount in USD
BASE_AMOUNT=2.0

# Minimum trade amount in USD
MIN_AMOUNT=1.0

# Maximum trade amount in USD
MAX_AMOUNT=20.0

# Default trade duration in minutes (1-5)
DEFAULT_DURATION=1

# ============================================================================
# RISK MANAGEMENT
# ============================================================================
# SECURITY: These limits protect your account from excessive losses

# Maximum daily loss in USD
# Trading stops if daily loss exceeds this amount
MAX_DAILY_LOSS=50.0

# Maximum daily profit in USD
# Trading stops if daily profit exceeds this amount (take profits)
MAX_DAILY_PROFIT=200.0

# Maximum consecutive losses before stopping
# System pauses after this many losses in a row
MAX_CONSECUTIVE_LOSSES=3

# Minimum account balance in USD
# Trading stops if balance falls below this
MIN_ACCOUNT_BALANCE=50.0

# ============================================================================
# DATABASE SETTINGS
# ============================================================================
# Database for storing trade history and analytics

# SQLite database path (relative or absolute)
DB_PATH=data/trades_advanced.db

# Alternative: PostgreSQL/MySQL connection string
# DATABASE_URL=postgresql://user:password@localhost/trading_db
# DATABASE_URL=mysql://user:password@localhost/trading_db

# Enable database logging (true/false)
# DB_LOGGING=true

# ============================================================================
# LOGGING SETTINGS
# ============================================================================
# Configure logging verbosity and output

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Detailed information for debugging
# INFO: General information about system operation
# WARNING: Warning messages
# ERROR: Error messages
# CRITICAL: Critical errors
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/trading.log

# Enable console logging (true/false)
# LOG_TO_CONSOLE=true

# Enable file logging (true/false)
# LOG_TO_FILE=true

# Verbose logging for debugging (true/false)
# VERBOSE=false

# ============================================================================
# MARKET ANALYSIS SETTINGS
# ============================================================================
# Technical analysis parameters

# Number of candles to analyze
CANDLE_COUNT=100

# Timeframe for candles: 1m, 5m, 15m, 30m, 1h, 4h, 1d
TIMEFRAME=1m

# ============================================================================
# API SETTINGS (Optional)
# ============================================================================
# REST API for external integrations

# Enable REST API (true/false)
# ENABLE_API=false

# API host (0.0.0.0 for all interfaces)
# API_HOST=0.0.0.0

# API port
# API_PORT=8000

# API key for authentication
# SECURITY: Generate a strong random key (min 32 characters)
# Example: openssl rand -hex 32
# API_KEY=your_secure_api_key_here

# ============================================================================
# MONITORING SETTINGS (Optional)
# ============================================================================
# Web-based monitoring dashboard

# Enable web monitoring dashboard (true/false)
# ENABLE_WEB_MONITOR=false

# Monitor port
# MONITOR_PORT=8080

# Update interval in seconds
# MONITOR_UPDATE_INTERVAL=5

# ============================================================================
# BACKTESTING SETTINGS (Optional)
# ============================================================================
# Historical strategy testing

# Initial balance for backtesting in USD
# BACKTEST_INITIAL_BALANCE=10000

# Backtest start date (YYYY-MM-DD)
# BACKTEST_START_DATE=2024-01-01

# Backtest end date (YYYY-MM-DD)
# BACKTEST_END_DATE=2024-12-31

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================
# Performance and reliability tuning

# Enable parallel processing (true/false)
# ENABLE_PARALLEL=true

# Number of worker threads
# NUM_WORKERS=4

# Request timeout in seconds
# REQUEST_TIMEOUT=30

# Maximum retry attempts for failed requests
# MAX_RETRIES=3

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# Debug and testing options

# Debug mode (true/false)
# Enables additional logging and checks
# DEBUG=false

# Dry run mode (true/false)
# SECURITY: Simulates trades without executing them
# Useful for testing strategies safely
# DRY_RUN=false

# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
# 1. CREDENTIALS:
#    - Use unique, strong passwords (min 12 characters)
#    - Include uppercase, lowercase, numbers, and symbols
#    - Never reuse passwords across services
#    - Rotate credentials regularly (every 90 days)
#
# 2. API KEYS:
#    - Keep API keys secret and secure
#    - Use API key rotation where supported
#    - Set spending limits on API accounts
#    - Monitor API usage for anomalies
#
# 3. ENVIRONMENT FILES:
#    - Never commit .env to version control
#    - Add .env to .gitignore
#    - Use different .env files per environment
#    - Backup .env files securely (encrypted)
#
# 4. ACCOUNT SECURITY:
#    - Always start with demo account for testing
#    - Enable 2FA on all trading accounts
#    - Use strong risk management settings
#    - Monitor account activity regularly
#
# 5. ACCESS CONTROL:
#    - Restrict file permissions on .env (chmod 600)
#    - Use separate credentials per environment
#    - Limit access to production credentials
#    - Audit credential access regularly
#
# 6. MONITORING:
#    - Enable logging to track system activity
#    - Review logs regularly for anomalies
#    - Set up alerts for unusual trading activity
#    - Monitor API key usage and quotas
#
# 7. VALIDATION:
#    - Run scripts/validate_secrets.py before deployment
#    - Validate credentials in staging before production
#    - Test with demo account first
#    - Verify all required secrets are set
#
# ============================================================================
# GETTING STARTED
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual credentials
# 3. Validate: python scripts/validate_secrets.py
# 4. Test with demo account first
# 5. Review docs/SECURITY_SETUP.md for detailed setup
#
# For help, see: docs/SECURITY_SETUP.md
# ============================================================================
# END OF CONFIGURATION
# ============================================================================