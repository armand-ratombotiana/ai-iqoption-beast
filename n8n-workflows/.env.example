# =====================================================
# IQOption AI Trading System - Environment Variables
# =====================================================
# Copy this file to .env and fill in your credentials
# IMPORTANT: Never commit .env to version control!
# =====================================================

# =====================================================
# AI MODEL API KEYS
# =====================================================

# OpenAI API Key (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-1234567890abcdef1234567890abcdef12345678

# Anthropic Claude API Key (get from: https://console.anthropic.com/)
CLAUDE_API_KEY=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

# DeepSeek API Key (get from: https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sk-d75da22f2d084043bdb3d4350cbeeb1e

# =====================================================
# IQOPTION CREDENTIALS
# =====================================================

# IQOption account email
IQOPTION_EMAIL=your_email@example.com

# IQOption account password
IQOPTION_PASSWORD=your_secure_password

# Account type: 'demo' or 'real' (ALWAYS START WITH DEMO!)
IQOPTION_ACCOUNT_TYPE=demo

# IQOption API URL (your trading API server)
IQOPTION_API_URL=http://localhost:5000

# =====================================================
# EMAIL / SMTP CONFIGURATION
# =====================================================

# SMTP Server Configuration
N8N_SMTP_USER=your_email@gmail.com
N8N_SMTP_PASS=your_app_password_here
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=587

# Email recipient for notifications
N8N_EMAIL_TO=judicael.ratombotiana@gmail.com

# Email notification mode:
# - 'per_trade': Send email after each trade (high volume)
# - 'daily': Send daily summary only
# - 'errors_only': Only send error alerts
# - 'errors_and_daily': Errors + daily summary
N8N_EMAIL_MODE=per_trade

# =====================================================
# GOOGLE SHEETS INTEGRATION
# =====================================================

# Google Sheets Document ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
N8N_GOOGLE_SHEETS_ID=1c3JjCL8lNub_l2qW3GYT6AhPMCV2MaG5zih4SRoBk8w
# Google OAuth2 Credentials (set up in n8n UI)
# Note: Configure Google Sheets OAuth2 credentials in n8n Settings > Credentials

# =====================================================
# POSTGRESQL DATABASE
# =====================================================

# PostgreSQL connection details
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iqoption_trading
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=secure_password_here

# Full connection string (alternative)
# DATABASE_URL=postgresql://trading_user:password@localhost:5432/iqoption_trading

# =====================================================
# TRADING CONFIGURATION
# =====================================================

# Trading interval in minutes (how often to check for signals)
# Default: 1 (every 1 minute)
N8N_TRADE_INTERVAL_MINUTES=1

# Default trade amount in dollars (0 = auto-calculate based on confidence)
N8N_TRADE_AMOUNT=1

# Default trading asset/pair
N8N_TRADE_ASSET=EURUSD

# Minimum confidence threshold for trades (0-100)
N8N_MIN_CONFIDENCE=70

# Maximum daily trades limit
N8N_MAX_DAILY_TRADES=100

# Maximum daily loss limit (in dollars)
N8N_MAX_DAILY_LOSS=1000

# =====================================================
# N8N CONFIGURATION
# =====================================================

# n8n instance URL (for webhooks and external access)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# n8n webhook URL (if using webhooks)
# WEBHOOK_URL=https://your-n8n-instance.com

# n8n timezone
GENERIC_TIMEZONE=America/New_York

# n8n execution mode
EXECUTIONS_MODE=regular

# =====================================================
# ADVANCED SETTINGS (Optional)
# =====================================================

# Enable debug logging
DEBUG_MODE=false

# Martingale settings (if using advanced risk management)
ENABLE_MARTINGALE=false
MARTINGALE_MULTIPLIER=2.0
MARTINGALE_MAX_LEVEL=3

# Trading hours (24-hour format, comma-separated)
# Example: "09:00-17:00" or "00:00-23:59" for 24/7
TRADING_HOURS=09:00-17:00

# Days to trade (0=Sunday, 1=Monday, ..., 6=Saturday)
# Example: "1,2,3,4,5" for weekdays only
TRADING_DAYS=1,2,3,4,5

# AI model weights for consensus (0-1, must sum to 1.0)
WEIGHT_OPENAI=0.33
WEIGHT_CLAUDE=0.34
WEIGHT_DEEPSEEK=0.33

# Retry settings for failed API calls
MAX_API_RETRIES=3
API_RETRY_DELAY=5000

# =====================================================
# MONITORING & ALERTS
# =====================================================

# Slack webhook (optional, for Slack notifications)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook (optional, for Discord notifications)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# Telegram bot (optional, for Telegram notifications)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# =====================================================
# SECURITY SETTINGS
# =====================================================

# Enable rate limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Enable IP whitelisting (comma-separated IPs)
# IP_WHITELIST=127.0.0.1,192.168.1.0/24

# =====================================================
# NOTES
# =====================================================
#
# 1. For Gmail SMTP:
#    - Use App Password, not your regular password
#    - Enable 2FA first, then generate App Password
#    - Go to: https://myaccount.google.com/apppasswords
#
# 2. For Google Sheets:
#    - Create credentials in n8n UI under Settings > Credentials
#    - Share your Google Sheet with the service account email
#
# 3. PostgreSQL:
#    - Ensure database exists before running workflows
#    - Run postgres_schema.sql to create tables
#
# 4. IQOption:
#    - ALWAYS test with demo account first
#    - Never share your credentials
#    - Use secure passwords
#
# 5. API Keys:
#    - Keep all API keys secure
#    - Rotate keys regularly
#    - Monitor usage and costs
#
# =====================================================
