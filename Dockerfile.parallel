# ============================================================================
# KAEL Autonomous Parallel Trading Bot - Alpine-based Docker Image
# ============================================================================
FROM python:3.11-alpine

# Set working directory
WORKDIR /app/app/KAEL/KAEL

# Install system dependencies for Alpine
# - build-base: gcc, g++, make and other build tools (replaces build-essential)
# - curl: for healthchecks
# - ca-certificates: SSL certificates
# - git: for installing packages from git repositories
# - libffi-dev: Foreign Function Interface library
# - openssl-dev: OpenSSL development headers
# - postgresql-dev: PostgreSQL client development headers
# - musl-dev: Standard C library for Alpine
# - linux-headers: Linux kernel headers for compilation
# - gfortran: Fortran compiler (needed for numpy/scipy)
# - openblas-dev: Optimized BLAS library for numpy
# - lapack-dev: Linear Algebra Package
# - wget, tar: for downloading and extracting TA-Lib
RUN apk add --no-cache \
    build-base \
    curl \
    wget \
    tar \
    ca-certificates \
    git \
    libffi-dev \
    openssl-dev \
    postgresql-dev \
    musl-dev \
    linux-headers \
    gfortran \
    openblas-dev \
    lapack-dev \
    && rm -rf /var/cache/apk/*

# Install TA-Lib (Technical Analysis Library)
# This provides 150+ technical indicators for advanced strategies
RUN cd /tmp \
    && wget http://prdownloads.sourceforge.net/ta-lib/ta-lib-0.4.0-src.tar.gz \
    && tar -xzf ta-lib-0.4.0-src.tar.gz \
    && cd ta-lib/ \
    && ./configure --prefix=/usr \
    && make \
    && make install \
    && cd / \
    && rm -rf /tmp/ta-lib*

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install numpy first (required for pandas and pandas-ta)
# Build from wheel to avoid compilation issues
RUN pip install --no-cache-dir numpy>=1.24.0

# Install pandas (required for pandas-ta)
RUN pip install --no-cache-dir pandas>=2.0.0

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
# pandas and numpy already installed, so this will skip them
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire project structure
COPY . .

# Create necessary directories
RUN mkdir -p logs

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/app/KAEL/KAEL:/app/app/KAEL/KAEL/src

# Verify critical imports
RUN python - <<'PY'
import importlib, sys
def ok(name, label=None):
    try:
        importlib.import_module(name)
        print(f"✅ {label or name} verified")
    except Exception as e:
        # Do not fail the build if optional libs (like pandas_ta) are missing;
        # just warn and continue. The runtime will handle availability.
        print(f"⚠️  {label or name} NOT available: {e}", file=sys.stderr)

ok('iqoptionapi.stable_api', 'iqoptionapi')
ok('flask')
ok('dotenv', 'python-dotenv')
ok('requests')
ok('pandas')
ok('numpy')
ok('talib', 'TA-Lib')
ok('strategies', 'Advanced Strategies Module')
PY

# Health check - check if the health API is responding
HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5001/health || exit 1

# Expose health API port
EXPOSE 5001

# Run the autonomous parallel trading bot
CMD ["python", "autonomous_parallel_trading_bot.py"]